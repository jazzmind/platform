  auditLogs         AuthAuditLog[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([name])
  @@index([isActive])
}

model Role {
  id                String @id @default(cuid())
  name              String                    // e.g., "meeting-owner", "viewer"
  displayName       String                    // e.g., "Meeting Owner"
