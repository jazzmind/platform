{
  "name": "sonnenreich-platforms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency=15",
    "dev:auth": "turbo dev --filter=@jazzmind/auth",
    "dev:meetings": "turbo dev --filter=@jazzmind/auth --filter=@jazzmind/meetings",
    "dev:events": "turbo dev --filter=@jazzmind/auth --filter=@jazzmind/events",
    "dev:bgmaker": "turbo dev --filter=@jazzmind/bgmaker",
    "dev:knowledgebase": "turbo dev --filter=@jazzmind/knowledgebase",
    "dev:polysec": "turbo dev --filter=polysec",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:fix": "node scripts/fix-prisma-deps.js",
    "db:consolidate": "node scripts/consolidate-schemas.js",
    "db:generate": "npm run db:consolidate && prisma generate",
    "db:push": "npm run db:consolidate && prisma db push",
    "db:migrate": "npm run db:consolidate && prisma migrate dev",
    "db:migrate:deploy": "npm run db:consolidate && prisma migrate deploy",
    "db:studio": "npm run db:consolidate && prisma studio",
    "db:seed": "npm run db:consolidate && prisma db seed"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.1",
    "glob": "^10.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.5.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0"
  },
  "packageManager": "npm@10.0.0"
}
