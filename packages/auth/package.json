{
  "name": "@jazzmind/auth",
  "version": "0.2.0",
  "private": false,
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./client": "./src/client.ts",
    "./components": "./components/index.ts",
    "./lib": "./lib/index.ts",
    "./prisma": "./prisma/index.ts",
    "./styles": "./src/app/globals.css"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:lib": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.5",
    "@jazzmind/shared": "*",
    "@prisma/adapter-pg": "^7.0.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/nodemailer": "^6.4.17",
    "better-auth": "^1.6.5",
    "dotenv": "^16.4.0",
    "next": "^15.0.0 || ^16.0.0",
    "nodemailer": "^8.0.5",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.11",
    "testcontainers": "^11.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazzmind/platform.git",
    "directory": "packages/auth"
  }
