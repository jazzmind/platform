// This is your Prisma schema file for PolySec
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model PolicyDocument {
  id         String   @id @default(cuid())
  title      String
  version    String?
  uploadDate DateTime @default(now())
  fileType   FileType
  fileName   String
  fileSize   Int
  fileUrl    String   // Vercel blob URL
  content    Json     // Extracted text and metadata
  sections   Json     // Document sections for search
  status     ProcessingStatus @default(PROCESSING)
  
  // Relations
  questionAnswers SecurityQuestion[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("policy_documents")
}

model SecurityQuestion {
  id         String   @id @default(cuid())
  question   String
  category   String?
  framework  String?
  answer     String?
  sources    Json?    // Array of referenced document sections
  confidence Float?   // Answer confidence score (0-1)
  
  // Relations
  documentId String?
  document   PolicyDocument? @relation(fields: [documentId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("security_questions")
}

model ComplianceFramework {
  id           String @id @default(cuid())
  name         String @unique // SOC2, ISO 27001, etc.
  requirements Json   // Framework requirements
  controls     Json   // Control mappings
  version      String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("compliance_frameworks")
}

// Models needed from knowledgebase for document processing
model FileData {
  id             String   @id @default(cuid())
  fileId         String
  entityType     String
  entityId       String
  dataType       String
  chunkIndex     Int?
  totalChunks    Int?
  content        String?
  contentHash    String?
  metadata       Json?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fileId, entityType, entityId])
  @@index([organizationId, dataType])
  @@index([entityType, entityId])
  @@index([fileId, dataType])
  @@index([contentHash])
  @@index([fileId, chunkIndex])
  @@map("file_data")
}

model Vector {
  id               String                @id @default(cuid())
  entityType       String
  entityId         String
  sourceEntityType String?
  sourceEntityId   String?
  contentHash      String?
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  embedding        Unsupported("vector")

  @@index([entityType, entityId])
  @@index([sourceEntityType, sourceEntityId])
  @@index([contentHash])
  @@map("vectors")
}

enum FileType {
  PDF
  DOCX
  TXT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
} 