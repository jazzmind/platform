generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model FileData {
  id             String   @id @default(cuid())
  fileId         String
  entityType     String
  entityId       String
  dataType       String
  chunkIndex     Int?
  totalChunks    Int?
  content        String?
  contentHash    String?
  metadata       Json?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fileId, entityType, entityId])
  @@index([organizationId, dataType])
  @@index([entityType, entityId])
  @@index([fileId, dataType])
  @@index([contentHash])
  @@index([fileId, chunkIndex])
  @@map("file_data")
}

model Vector {
  id               String                @id @default(cuid())
  entityType       String
  entityId         String
  sourceEntityType String?
  sourceEntityId   String?
  contentHash      String?
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  embedding        Unsupported("vector")

  @@index([entityType, entityId])
  @@index([sourceEntityType, sourceEntityId])
  @@index([contentHash])
  @@map("vectors")
}

model Section {
  id             String   @id @default(cuid())
  sectionGroupId String
  entityType     String
  entityId       String
  organizationId String
  type           String
  title          String
  content        String?
  version        Int      @default(1)
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  modifiedAt     DateTime @updatedAt

  @@index([entityType, entityId, isActive])
  @@index([organizationId])
  @@index([entityType, entityId, order])
  @@index([sectionGroupId])
  @@index([entityType, entityId, sectionGroupId, version])
  @@index([createdBy])
  @@map("sections")
}

model ProcessingJob {
  id             String           @id @default(cuid())
  processingId   String           @unique
  fileId         String
  entityType     String
  entityId       String
  organizationId String
  status         ProcessingStatus @default(PENDING)
  stage          ProcessingStage  @default(UPLOADING)
  progress       Int              @default(0)
  totalSteps     Int              @default(5)
  currentStep    Int              @default(0)
  message        String?
  result         Json?
  error          String?
  metadata       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([processingId])
  @@index([fileId])
  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@map("processing_jobs")
}

model Document {
  id             String           @id @default(cuid())
  fileId         String           @unique
  filename       String
  originalName   String
  fileType       DocumentFileType
  mimeType       String
  fileSize       Int
  blobUrl        String
  entityType     String
  entityId       String
  organizationId String
  uploadedBy     String?
  status         DocumentStatus   @default(UPLOADED)
  extractedAt    DateTime?
  processedAt    DateTime?
  tags           String[]
  classification Json?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([fileId])
  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([status])
  @@index([fileType])
  @@index([uploadedBy])
  @@map("documents")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuthAuditLog {
  id           String      @id
  userId       String?
  targetUserId String?
  packageId    String?
  action       AuditAction
  resourceType String?
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())
  Package      Package?    @relation(fields: [packageId], references: [id])
  User         User?       @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([packageId])
  @@index([targetUserId])
  @@index([userId])
}

model Authenticator {
  id                   String   @id
  userId               String
  counter              BigInt
  credentialDeviceType String?  @default("platform")
  credentialBackedUp   Boolean? @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  credentialPublicKey  Bytes
  credentialID         Bytes    @unique
  transports           String[]
  User                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MeetingEvent {
  id               String             @id
  title            String
  description      String?
  objective        String?
  location         String?
  organizerId      String
  createdBy        String?
  participantIds   String[]
  calendarIds      String[]
  isGroupEvent     Boolean            @default(false)
  duration         Int?
  dateRangeStart   DateTime?
  dateRangeEnd     DateTime?
  frequency        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  ScheduledMeeting ScheduledMeeting[]
  UserAvailability UserAvailability[]

  @@index([organizerId])
}

model Package {
  id               String           @id
  name             String           @unique
  displayName      String
  description      String?
  registrationType RegistrationType @default(APPROVAL_REQUIRED)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  AuthAuditLog     AuthAuditLog[]
  Permission       Permission[]
  ResourceAccess   ResourceAccess[]
  Role             Role[]
  RoleAssignment   RoleAssignment[]

  @@index([isActive])
  @@index([name])
}

model PasskeyChallenge {
  id        String   @id
  userId    String   @unique
  challenge String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id             String           @id
  name           String
  displayName    String
  description    String?
  packageId      String
  category       String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Package        Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  RolePermission RolePermission[]

  @@unique([name, packageId])
  @@index([category])
  @@index([packageId])
}

model ResourceAccess {
  id                                  String     @id
  userId                              String
  packageId                           String
  resourceType                        String
  resourceId                          String
  accessType                          AccessType
  grantedBy                           String?
  expiresAt                           DateTime?
  isActive                            Boolean    @default(true)
  metadata                            Json?
  createdAt                           DateTime   @default(now())
  updatedAt                           DateTime
  User_ResourceAccess_grantedByToUser User?      @relation("ResourceAccess_grantedByToUser", fields: [grantedBy], references: [id])
  Package                             Package    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  User_ResourceAccess_userIdToUser    User       @relation("ResourceAccess_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, packageId, resourceType, resourceId, accessType])
  @@index([accessType])
  @@index([isActive])
  @@index([packageId])
  @@index([resourceType, resourceId])
  @@index([userId])
}

model Role {
  id             String           @id
  name           String
  displayName    String
  description    String?
  packageId      String?
  isSystemRole   Boolean          @default(false)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Package        Package?         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  RoleAssignment RoleAssignment[]
  RolePermission RolePermission[]

  @@unique([name, packageId])
  @@index([isSystemRole])
  @@index([packageId])
}

model RoleAssignment {
  id                                  String    @id
  userId                              String
  roleId                              String
  packageId                           String?
  resourceType                        String?
  resourceId                          String?
  grantedBy                           String?
  expiresAt                           DateTime?
  isActive                            Boolean   @default(true)
  metadata                            Json?
  createdAt                           DateTime  @default(now())
  updatedAt                           DateTime
  User_RoleAssignment_grantedByToUser User?     @relation("RoleAssignment_grantedByToUser", fields: [grantedBy], references: [id])
  Package                             Package?  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  Role                                Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  User_RoleAssignment_userIdToUser    User      @relation("RoleAssignment_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, packageId, resourceType, resourceId])
  @@index([isActive])
  @@index([packageId])
  @@index([resourceType, resourceId])
  @@index([roleId])
  @@index([userId])
}

model RolePermission {
  id           String     @id
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  Role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([roleId])
}

model ScheduledMeeting {
  id             String       @id
  meetingEventId String
  title          String
  startTime      DateTime
  endTime        DateTime
  location       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  participantIds String[]
  MeetingEvent   MeetingEvent @relation(fields: [meetingEventId], references: [id], onDelete: Cascade)

  @@index([meetingEventId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                                            String            @id
  name                                          String?
  email                                         String?           @unique
  emailVerified                                 DateTime?
  image                                         String?
  createdAt                                     DateTime          @default(now())
  updatedAt                                     DateTime
  Account                                       Account[]
  AuthAuditLog                                  AuthAuditLog[]
  Authenticator                                 Authenticator[]
  PasskeyChallenge                              PasskeyChallenge?
  ResourceAccess_ResourceAccess_grantedByToUser ResourceAccess[]  @relation("ResourceAccess_grantedByToUser")
  ResourceAccess_ResourceAccess_userIdToUser    ResourceAccess[]  @relation("ResourceAccess_userIdToUser")
  RoleAssignment_RoleAssignment_grantedByToUser RoleAssignment[]  @relation("RoleAssignment_grantedByToUser")
  RoleAssignment_RoleAssignment_userIdToUser    RoleAssignment[]  @relation("RoleAssignment_userIdToUser")
  Session                                       Session[]
}

model UserAvailability {
  id             String       @id
  meetingEventId String
  userId         String
  calendarId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  availableSlots Json
  MeetingEvent   MeetingEvent @relation(fields: [meetingEventId], references: [id], onDelete: Cascade)

  @@unique([meetingEventId, userId, calendarId])
  @@index([meetingEventId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  id         String   @id

  @@unique([identifier, token])
}

model compliance_frameworks {
  id           String   @id
  name         String   @unique
  requirements Json
  controls     Json
  version      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model evidence {
  id            String         @id
  projectId     String
  activityId    String?
  fileId        String
  type          EvidenceType
  description   String
  uploadedAt    DateTime       @default(now())
  uploadedBy    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  rd_activities rd_activities? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  projects      projects       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model policy_documents {
  id                 String               @id
  title              String
  version            String?
  uploadDate         DateTime             @default(now())
  fileType           FileType
  fileName           String
  fileSize           Int
  fileUrl            String
  content            Json
  sections           Json
  status             ProcessingStatus     @default(PROCESSING)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  security_questions security_questions[]
}

model projects {
  id             String          @id
  name           String
  reference      String?
  startDate      DateTime
  endDate        DateTime
  totalBudget    Decimal?        @db.Decimal(15, 2)
  description    String
  primaryContact String?
  status         ProjectStatus   @default(ACTIVE)
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  createdBy      String?
  evidence       evidence[]
  rd_activities  rd_activities[]
  rd_narratives  rd_narratives[]
}

model rd_activities {
  id            String          @id
  projectId     String
  type          ActivityType
  name          String
  hypothesis    String?
  experiments   String?
  results       String?
  startDate     DateTime
  endDate       DateTime
  expenditure   Decimal?        @db.Decimal(15, 2)
  status        ActivityStatus  @default(PLANNED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  evidence      evidence[]
  projects      projects        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rd_narratives rd_narratives[]
  time_entries  time_entries[]
}

model rd_narratives {
  id            String         @id
  projectId     String
  activityId    String?
  type          NarrativeType
  content       String
  version       Int            @default(1)
  generatedAt   DateTime       @default(now())
  approved      Boolean        @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  rd_activities rd_activities? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  projects      projects       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model security_questions {
  id               String            @id
  question         String
  category         String?
  framework        String?
  answer           String?
  sources          Json?
  confidence       Float?
  documentId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  policy_documents policy_documents? @relation(fields: [documentId], references: [id])
}

model time_entries {
  id             String        @id
  activityId     String
  userId         String
  date           DateTime      @db.Date
  hours          Decimal       @db.Decimal(5, 2)
  description    String
  approved       Boolean       @default(false)
  approvedBy     String?
  approvedAt     DateTime?
  evidenceFileId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  rd_activities  rd_activities @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProcessingStage {
  UPLOADING
  EXTRACTING
  CHUNKING
  EMBEDDING
  ANALYZING
  COMPLETING
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  PROCESSING
  PROCESSED
  FAILED
}

enum DocumentFileType {
  PDF
  DOCX
  TXT
  HTML
  MD
  CSV
  XLSX
  PPTX
}

enum AccessType {
  OWNER
  EDITOR
  VIEWER
  LIMITED_EDITOR
  COLLABORATOR
  CUSTOM
}

enum ActivityStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CORE
  SUPPORTING
}

enum AuditAction {
  ROLE_ASSIGNED
  ROLE_REVOKED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  RESOURCE_ACCESS_GRANTED
  RESOURCE_ACCESS_REVOKED
  PACKAGE_REGISTERED
  PACKAGE_DEACTIVATED
  USER_APPROVED
  USER_DENIED
}

enum EvidenceType {
  DOCUMENT
  EXPERIMENT_DATA
  LITERATURE_REVIEW
  MEETING_NOTES
  TECHNICAL_SPECIFICATION
  RESEARCH_PAPER
}

enum FileType {
  PDF
  DOCX
  TXT
}

enum NarrativeType {
  CORE_ACTIVITY
  SUPPORTING_ACTIVITY
  PROJECT_SUMMARY
  COMPLIANCE_REPORT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RegistrationType {
  SELF_REGISTER
  APPROVAL_REQUIRED
  ADMIN_ONLY
}
